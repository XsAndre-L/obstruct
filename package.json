    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "dependencies": {
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3"
