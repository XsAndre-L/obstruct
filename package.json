{
  "name": "obstruct",
  "version": "1.1.0",
  "description": "Reusable vault names and focused folder views for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/test.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "package": "npm run build && node scripts/package.mjs"
  },
  "author": "Andre Loubser",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  }
}
